----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.6/crypto",
  "moonbitlang/x@0.5.6/sys",
}
----

///|
/// Build the Extism kernel from its Zig source and embed it, or check the embedded bytes.
///
/// - `build` runs `zig build` in `kernel/` into `_build/kernel/` and writes
///   `pkgs/extism/kernel/kernel_bytes.mbt` with the bytes and their SHA-256.
/// - `check` makes the same build and fails when the file differs from the embedded one.
/// - `test` runs the Zig tests of the kernel (`zig build test`).
///
/// Usage: `mise run build:kernel`, `mise run check:kernel`, `mise run test:kernel`, or
/// `moonx scripts/toolchain.mbtx scripts/kernel.mbtx [build|check|test]`.|check]`.
/// It exits with 0 on success, 1 when the build fails or the check finds a difference, and 2 on a
/// usage error.

///|
/// The package file that holds the embedded kernel.
let embedded_file : String = "pkgs/extism/kernel/kernel_bytes.mbt"

///|
/// The Zig install prefix of the build, under the ignored `_build/` directory.
let build_prefix : String = "_build/kernel"

///|
/// Bytes per line of the hex text in the generated file.
let bytes_per_line : Int32 = 48

///|
enum Operation {
  Build
  Check
  Test
}

///|
fn Operation::parse(args : ArrayView[String]) -> Operation? {
  match args {
    ["build"] => Some(Build)
    ["check"] => Some(Check)
    ["test"] => Some(Test)
    _ => None
  }
}

///|
test "the operation is build, check or test" {
  assert_true(Operation::parse(["build"]) is Some(Build))
  assert_true(Operation::parse(["check"]) is Some(Check))
  assert_true(Operation::parse(["test"]) is Some(Test))
  assert_true(Operation::parse([]) is None)
  assert_true(Operation::parse(["build", "check"]) is None)
}

///|
fn hex(bytes : BytesView) -> String {
  let digits = "0123456789abcdef"
  let text = StringBuilder()
  for byte in bytes {
    let value = byte.to_int()
    text.write_char(digits.get_char(value >> 4).unwrap())
    text.write_char(digits.get_char(value & 15).unwrap())
  }
  text.to_string()
}

///|
/// The MoonBit source of `kernel_bytes.mbt` for the kernel `bytes` with the SHA-256 `digest`, in the
/// layout that `moon fmt` keeps.
fn render(bytes : Bytes, digest : String) -> String {
  let text = StringBuilder()
  text.write_string(
    (
      $|///|
      $|// Generated by `mise run build:kernel` from kernel/src. Do not edit this file:
      $|// `mise run check:kernel` fails when it differs from a fresh build.
      $|
      $|///|
      $|/// The SHA-256 of the kernel bytes, in lowercase hex.
      $|
    ),
  )
  text.write_string("let kernel_sha256 : String = \"\{digest}\"\n\n")
  text.write_string(
    (
      $|///|
      $|/// The kernel module, in lowercase hex.
      $|let kernel_hex : String =
      $|
    ),
  )
  let mut start = 0
  while start < bytes.length() {
    let end = if start + bytes_per_line < bytes.length() {
      start + bytes_per_line
    } else {
      bytes.length()
    }
    text.write_string("  #|\{hex(bytes[start:end])}\n")
    start = end
  }
  text.to_string()
}

///|
test "render writes the digest and the bytes as hex lines" {
  let bytes = Bytes::makei(50, i => i.to_byte())
  let source = render(bytes, "ab")
  assert_true(source.contains("let kernel_sha256 : String = \"ab\"\n"))
  assert_true(
    source.contains(
      "  #|000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f\n  #|3031\n",
    ),
  )
  assert_true(source.has_suffix("  #|3031\n"))
}

///|
suberror KernelError {
  KernelError(String)
}

///|
/// Build the kernel with the pinned Zig and give its bytes.
async fn build_kernel() -> Bytes {
  let prefix = @fs.realpath(".") + "/" + build_prefix
  let code = @process.run(
    "zig",
    ["build", "--prefix", prefix],
    cwd="kernel",
    stdout=@stdio.stderr,
    stderr=@stdio.stderr,
  )
  guard code == 0 else {
    raise KernelError("zig build failed in kernel/ with status \{code}")
  }
  @fs.read_file("\{prefix}/bin/kernel.wasm").binary()
}

///|
async fn main {
  guard Operation::parse(@env.args()[1:]) is Some(operation) else {
    eprintln("Usage: kernel.mbtx [build|check|test]")
    @sys.exit(2)
    return
  }
  try {
    if operation is Test {
      let code = @process.run(
        "zig",
        ["build", "test", "--summary", "all"],
        cwd="kernel",
        stdout=@stdio.stdout,
        stderr=@stdio.stderr,
      )
      guard code == 0 else {
        raise KernelError("zig build test failed with status \{code}")
      }
      println("✅ The kernel tests passed")
      return
    }
    let bytes = build_kernel()
    let source = render(
      bytes,
      @crypto.bytes_to_hex_string(@crypto.sha256(bytes)),
    )
    match operation {
      Build => {
        @fs.write_file(embedded_file, source)
        println("✅ Wrote \{embedded_file} (\{bytes.length()} bytes)")
      }
      Test => ()
      Check => {
        let embedded = if @fs.exists(embedded_file) {
          @fs.read_file(embedded_file).text()
        } else {
          ""
        }
        guard embedded == source else {
          raise KernelError(
            "\{embedded_file} differs from a fresh build of kernel/src; run mise run build:kernel",
          )
        }
        println("✅ \{embedded_file} matches a fresh build of kernel/src")
      }
    }
  } catch {
    KernelError(message) => {
      eprintln("❌ \{message}")
      @sys.exit(1)
    }
    error => {
      eprintln("❌ \{error}")
      @sys.exit(1)
    }
  }
}
